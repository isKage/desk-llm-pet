{
  "id": "llm-chat",
  "name": "AI 对话",
  "version": "1.0.0",
  "description": "独立的 AI 对话窗口，支持多会话、流式回复和本地保存。",
  "author": "isKage",
  "apiVersion": 1,
  "main": "main.js",
  "preload": "preload.js",
  "enabled": true,
  "contributes": {
    "petMenu": [
      { "command": "open-chat", "label": "AI 对话", "icon": "💬", "order": 10 }
    ],
    "trayMenu": [
      { "command": "open-chat", "label": "AI 对话", "icon": "💬", "order": 10 }
    ],
    "settings": {
      "title": "AI 对话",
      "icon": "💬",
      "description": "独立配置 AI 对话；留空则使用本体的 API 配置。",
      "fields": [
        {
          "key": "apiKey",
          "label": "API Key",
          "type": "password",
          "default": "",
          "placeholder": "sk-xxxxxxxxxxxxxxxx",
          "hint": "留空则使用「API 配置」中的 Key。"
        },
        {
          "key": "apiEndpoint",
          "label": "API 地址",
          "type": "text",
          "default": "",
          "placeholder": "https://api.deepseek.com",
          "hint": "留空则使用「API 配置」中的地址。"
        },
        {
          "key": "model",
          "label": "模型",
          "type": "text",
          "default": "deepseek-chat",
          "placeholder": "deepseek-chat",
          "hint": "如 deepseek-chat、deepseek-reasoner。"
        },
        {
          "key": "temperature",
          "label": "随机性",
          "type": "number",
          "default": 0.7,
          "min": 0,
          "max": 2,
          "step": 0.1,
          "hint": "越大回答越发散。"
        },
        {
          "key": "maxTokens",
          "label": "单次回复上限",
          "type": "number",
          "default": 2048,
          "min": 1,
          "max": 65536,
          "step": 1,
          "hint": "单次回复的最大长度。"
        },
        {
          "key": "stream",
          "label": "流式输出",
          "type": "boolean",
          "default": true,
          "hint": "开启后逐字显示。"
        },
        {
          "key": "systemPrompt",
          "label": "系统提示词",
          "type": "textarea",
          "default": "你是 DeskLLMPet 的桌面宠物助手，名字叫「大肥鱼」。回答简洁、友好、有条理；能用列表就用列表。",
          "rows": 3,
          "hint": "定义 AI 的身份和回答风格。"
        }
      ],
      "actions": [
        { "id": "test", "label": "🔗 测试连接", "style": "secondary" }
      ]
    }
  }
}
